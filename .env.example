ENVIRONMENT=1
# Async SQLAlchemy URL against existing Supabase Postgres (pooler recommended).
# Example: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

DATABASE_POOL_SIZE=10
DATABASE_POOL_OVERFLOW=5
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_TIMEOUT=30

CORS_ALLOWED_ORIGINS=["*"]

# Supabase project used by zemen_service (betegna / prod)
SUPABASE_URL=https://rffptyqhqvzrpmyxlwwu.supabase.co
SUPABASE_ANON_KEY=
# JWT secret from Supabase project settings (HS256). Prefer secret manager — never commit.
SUPABASE_JWT_SECRET=
# Optional: audience claim (often "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated
# Prefer JWKS when project uses asymmetric signing
SUPABASE_JWT_USE_JWKS=false

# Optional service role for privileged server jobs only (never expose to clients)
SUPABASE_SERVICE_ROLE_KEY=
