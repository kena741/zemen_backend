# Environment: development, staging, production
ENVIRONMENT=development

# Database URLs filtered by ENVIRONMENT:
# If ENVIRONMENT=development -> DEVELOPMENT_DATABASE_URL is assigned to DATABASE_URL
# If ENVIRONMENT=staging     -> STAGING_DATABASE_URL is assigned to DATABASE_URL
# If ENVIRONMENT=production  -> PRODUCTION_DATABASE_URL is assigned to DATABASE_URL
DEVELOPMENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zemen_db
STAGING_DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
PRODUCTION_DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional direct override (if set and environment-specific URL is omitted)
DATABASE_URL=

# Database Pool Settings (Defaults: 5/2 for dev, 10/5 for staging & prod)
DATABASE_POOL_SIZE=
DATABASE_POOL_OVERFLOW=
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

CORS_ALLOWED_ORIGINS=["*"]

# Supabase project used by zemen_service (betegna / prod)
SUPABASE_URL=https://rffptyqhqvzrpmyxlwwu.supabase.co
SUPABASE_ANON_KEY=
# JWT secret from Supabase project settings (HS256). Prefer secret manager — never commit.
SUPABASE_JWT_SECRET=
# Optional: audience claim (often "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated
# Prefer JWKS when project uses asymmetric signing
SUPABASE_JWT_USE_JWKS=false

# Optional service role for privileged server jobs only (never expose to clients)
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Telegram Bot Webhook Integration
# ==============================================================================
# Environment-specific Bot Tokens and Webhook URLs:
DEVELOPMENT_TELEGRAM_BOT_TOKEN=
DEVELOPMENT_TELEGRAM_WEBHOOK_SECRET=
DEVELOPMENT_TELEGRAM_WEBHOOK_URL=

STAGING_TELEGRAM_BOT_TOKEN=
STAGING_TELEGRAM_WEBHOOK_SECRET=
STAGING_TELEGRAM_WEBHOOK_URL=

PRODUCTION_TELEGRAM_BOT_TOKEN=
PRODUCTION_TELEGRAM_WEBHOOK_SECRET=
PRODUCTION_TELEGRAM_WEBHOOK_URL=

# Optional direct override (if set and environment-specific is omitted)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_AUTO_REGISTER_WEBHOOK=true
